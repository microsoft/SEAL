prefix=@CMAKE_INSTALL_PREFIX@
libdir=@SEAL_PKGCONFIG_LIBDIR@
includedir=@SEAL_PKGCONFIG_INCLUDEDIR@

Name: Microsoft SEAL
Version: @SEAL_VERSION_MAJOR@.@SEAL_VERSION_MINOR@
Description: An easy-to-use homomorphic encryption library

Requires: @SEAL_PKGCONFIG_REQUIRES_STRING@

Libs: -L${libdir} -lseal
Cflags: @SEAL_LANG_FLAG@ -I${includedir}@SEAL_PKGCONFIG_THIRDPARTY_CFLAGS@
